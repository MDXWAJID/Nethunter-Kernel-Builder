[
  {
    "kernelSource": {
      "name": "StormBreaker-Phoenix",
      "repo": "https://github.com/stormbreaker-project/kernel_xiaomi_phoenix",
      "branch": "main",
      "device": "vendor/phoenix"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gas/linux-x86",
        "branch": "master",
        "name": "gas"
      },
      {
        "repo": "https://gitlab.com/ThankYouMario/android_prebuilts_clang-standalone/",
        "branch": "11",
        "name": "clang"
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
      "CROSS_COMPILE_COMPAT": "arm-linux-gnueabi-",
      "CLANG_TRIPLE": "aarch64-linux-gnu-",
      "CC": "clang"
    },
    "extraParams": {
      "CONFIG_LOCALVERSION": "\"-StormBreaker-NetHunter\"",
      "CONFIG_WIRELESS": "y",
      "CONFIG_MAC80211": "y",
      "CONFIG_CFG80211": "y",
      "CONFIG_WEXT_CORE": "y",
      "CONFIG_WEXT_PROC": "y",
      "CONFIG_WEXT_PRIV": "y",
      "CONFIG_WEXT_SPY": "y",
      "CONFIG_PACKET": "y",
      "CONFIG_UNIX": "y",
      "CONFIG_INET": "y",
      "CONFIG_NETFILTER": "y",
      "CONFIG_NF_CONNTRACK": "y",
      "CONFIG_NETFILTER_XTABLES": "y",
      "CONFIG_NETFILTER_XT_MATCH_STATE": "y",
      "CONFIG_IP_NF_IPTABLES": "y",
      "CONFIG_IP_NF_FILTER": "y",
      "CONFIG_IP_NF_NAT": "y",
      "CONFIG_ATH_CARDS": "y",
      "CONFIG_ATH9K_HW": "y",
      "CONFIG_ATH9K_COMMON": "y",
      "CONFIG_ATH9K_HTC": "y",
      "CONFIG_ATH9K_HTC_DBGPRINT": "y",
      "CONFIG_RTL88XXAU": "m",
      "CONFIG_RTL8192EU": "m",
      "CONFIG_RTL8192CU": "m",
      "CONFIG_R8188EU": "m",
      "CONFIG_MT7601U": "m",
      "CONFIG_USB_NET_DRIVERS": "y",
      "CONFIG_USB_RTL8150": "m",
      "CONFIG_USB_RTL8152": "m",
      "CONFIG_USB_NET_RNDIS_HOST": "m",
      "CONFIG_USB_NET_CDC_EEM": "m",
      "CONFIG_USB_NET_CDC_ETHER": "m",
      "CONFIG_UHID": "m",
      "CONFIG_HID": "y",
      "CONFIG_USB_HID": "y",
      "CONFIG_MACVLAN": "y",
      "CONFIG_SYSVIPC": "y",
      "CONFIG_POSIX_MQUEUE": "y",
      "CONFIG_CROSS_MEMORY_ATTACH": "y",
      "CONFIG_BT": "y",
      "CONFIG_BT_HCIBTUSB": "m",
      "CONFIG_BT_HCIUART": "m",
      "CONFIG_USB_SERIAL": "y",
      "CONFIG_USB_SERIAL_OPTION": "m"
    }
  }
]
